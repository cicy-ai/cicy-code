{
  "name": "cicy-code-server-bridge",
  "displayName": "CiCy Code Server Bridge",
  "description": "Explorer context actions for sending file paths to the current CiCy agent.",
  "version": "0.0.4",
  "publisher": "cicy-ai",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cicy.sendPathToCurrentAgent",
    "onCommand:cicy.sendActiveDocumentToCurrentAgent",
    "onCommand:cicy.showFileInfo",
    "onCommand:cicy.addToFavorites"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "cicy.sendPathToCurrentAgent",
        "title": "%cicy.sendPathToCurrentAgent.title%"
      },
      {
        "command": "cicy.sendActiveDocumentToCurrentAgent",
        "title": "%cicy.sendActiveDocumentToCurrentAgent.title%"
      },
      {
        "command": "cicy.showFileInfo",
        "title": "%cicy.showFileInfo.title%"
      },
      {
        "command": "cicy.addToFavorites",
        "title": "%cicy.addToFavorites.title%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cicy.sendPathToCurrentAgent",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "navigation@1000"
        },
        {
          "command": "cicy.showFileInfo",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "navigation@1001"
        },
        {
          "command": "cicy.addToFavorites",
          "when": "resourceScheme == file",
          "group": "navigation@1002"
        }
      ],
      "editor/context": [
        {
          "command": "cicy.sendActiveDocumentToCurrentAgent",
          "group": "navigation@1000"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.8.3"
  }
}
