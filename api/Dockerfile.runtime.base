FROM node:22-bookworm-slim

ARG BASE_DOCKERFILE_HASH=unknown
LABEL cicy.base_dockerfile_hash="${BASE_DOCKERFILE_HASH}"

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_CACHE=/tmp/npm-cache \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 \
    PATH="/root/.npm-global/bin:/root/.local/bin:/root/.opencode/bin:${PATH}" \
    PORT=8008 \
    CS_PORT=8002 \
    CICY_NO_BROWSER=1

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        python3 \
        sudo \
        tmux \
        unzip \
        vim \
        procps \
        fonts-wqy-microhei \
    ; \
    curl -fsSL https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb -o /tmp/cloudflared.deb; \
    apt-get install -y /tmp/cloudflared.deb; \
    rm -f /tmp/cloudflared.deb; \
    if ! id -u cicy >/dev/null 2>&1; then useradd -m -s /bin/bash cicy; fi; \
    echo 'cicy ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/cicy; \
    chmod 0440 /etc/sudoers.d/cicy; \
    curl -fsSL https://code-server.dev/install.sh | sh; \
    rm -rf \
        /usr/lib/code-server/src \
        /usr/lib/code-server/README.md \
        /usr/lib/code-server/LICENSE \
        /usr/lib/code-server/ThirdPartyNotices.txt \
        /usr/lib/code-server/postinstall.sh \
        /usr/lib/code-server/npm-shrinkwrap.json \
    ; \
    npm cache clean --force; \
    rm -rf /var/lib/apt/lists/* /tmp/npm-cache /root/.npm /root/.cache /tmp/* /var/tmp/*

USER cicy
RUN set -eux; \
    mkdir -p /home/cicy/.npm-global; \
    npm config set prefix /home/cicy/.npm-global
