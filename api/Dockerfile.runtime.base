FROM node:24-bookworm-slim

ARG BASE_DOCKERFILE_HASH=unknown
ARG GITHUB_PROXY=https://ghfast.top/
LABEL cicy.base_dockerfile_hash="${BASE_DOCKERFILE_HASH}"

ENV CICY_HOME=/home/cicy \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_CACHE=/tmp/npm-cache \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 \
    PATH="/root/.npm-global/bin:/root/.local/bin:/root/.opencode/bin:${PATH}" \
    PORT=8008 \
    CS_PORT=8002 \
    CICY_NO_BROWSER=1

# Use the image's default Debian sources (deb.debian.org). The previous tuna
# mirror rewrite started failing (http → 403, https → unreachable from the build
# host), which silently broke base/runtime image builds. The default mirror builds
# reliably both in CI and locally; switch back to a CN mirror here only if CI needs
# the speed and that mirror is reachable from the build network.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        cron \
        curl \
        git \
        jq \
        openssh-client \
        openssh-server \
        python3 \
        ripgrep \
        rsync \
        sudo \
        supervisor \
        tini \
        tmux \
        unzip \
        vim \
        procps \
    ; \
    curl -fsSL "${GITHUB_PROXY}https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb" -o /tmp/cloudflared.deb; \
    apt-get install -y /tmp/cloudflared.deb; \
    rm -f /tmp/cloudflared.deb; \
    if ! id -u cicy >/dev/null 2>&1; then useradd -m -s /bin/bash cicy; fi; \
    echo 'cicy ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/cicy; \
    chmod 0440 /etc/sudoers.d/cicy; \
    npm cache clean --force; \
    rm -rf /var/lib/apt/lists/* /tmp/npm-cache /root/.npm /root/.cache /tmp/* /var/tmp/*

# ffmpeg and CJK fonts are NOT preinstalled — ffmpeg is lazy-installed by
# setup.go (ensureFfmpegAsync → apt-get install -y ffmpeg) on first
# voice/recording feature use; ~150MB extra at runtime.
# This keeps the base image lean (~350MB instead of ~1.5GB).
# (Historical note: code-server was also lazy-installed here. It was removed
# when native files (api/mgr/files.go + app/src/components/files/) shipped.)

USER cicy
ENV HOME=$CICY_HOME \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    PATH="$CICY_HOME/.npm-global/bin:$CICY_HOME/.local/bin:$CICY_HOME/.opencode/bin:${PATH}"
RUN set -eux; \
    mkdir -p "$CICY_HOME/.npm-global"; \
    npm config set prefix "$CICY_HOME/.npm-global"; \
    rm -rf "$CICY_HOME/.cache" /tmp/npm-cache /tmp/* /var/tmp/*
