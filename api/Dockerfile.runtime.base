FROM node:22-bookworm-slim

ARG BASE_DOCKERFILE_HASH=unknown
ARG GITHUB_PROXY=https://ghfast.top/
LABEL cicy.base_dockerfile_hash="${BASE_DOCKERFILE_HASH}"

ENV CICY_HOME=/home/cicy \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_CACHE=/tmp/npm-cache \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 \
    PATH="/root/.npm-global/bin:/root/.local/bin:/root/.opencode/bin:${PATH}" \
    PORT=8008 \
    CS_PORT=8002 \
    CICY_NO_BROWSER=1

RUN set -eux; \
    printf '%s\n' \
        'Types: deb' \
        'URIs: http://mirrors.tuna.tsinghua.edu.cn/debian' \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        '' \
        'Types: deb' \
        'URIs: http://mirrors.tuna.tsinghua.edu.cn/debian-security' \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        > /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        jq \
        openssh-client \
        python3 \
        ripgrep \
        sudo \
        tmux \
        unzip \
        vim \
        procps \
        fonts-wqy-microhei \
    ; \
    curl -fsSL "${GITHUB_PROXY}https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb" -o /tmp/cloudflared.deb; \
    apt-get install -y /tmp/cloudflared.deb; \
    rm -f /tmp/cloudflared.deb; \
    if ! id -u cicy >/dev/null 2>&1; then useradd -m -s /bin/bash cicy; fi; \
    echo 'cicy ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/cicy; \
    chmod 0440 /etc/sudoers.d/cicy; \
    npm cache clean --force; \
    rm -rf /var/lib/apt/lists/* /tmp/npm-cache /root/.npm /root/.cache /tmp/* /var/tmp/*

RUN set -eux; \
    curl --http1.1 --retry 5 --retry-delay 2 --retry-all-errors -fsSL "${GITHUB_PROXY}https://raw.githubusercontent.com/cdr/code-server/main/install.sh" \
      | sed \
          -e "s#https://github.com/coder/code-server/releases/download/#${GITHUB_PROXY}https://github.com/coder/code-server/releases/download/#g" \
      | sh -s -- --method standalone --prefix /usr/local; \
    rm -rf \
        /usr/local/lib/code-server/src \
        /usr/local/lib/code-server/README.md \
        /usr/local/lib/code-server/LICENSE \
        /usr/local/lib/code-server/ThirdPartyNotices.txt \
        /usr/local/lib/code-server/postinstall.sh \
        /usr/local/lib/code-server/npm-shrinkwrap.json \
    ; \
    rm -rf /tmp/npm-cache /tmp/* /var/tmp/*

USER cicy
ENV HOME=$CICY_HOME \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    PATH="$CICY_HOME/.npm-global/bin:$CICY_HOME/.local/bin:$CICY_HOME/.opencode/bin:${PATH}"
RUN set -eux; \
    mkdir -p "$CICY_HOME/.npm-global"; \
    npm config set prefix "$CICY_HOME/.npm-global"; \
    rm -rf "$CICY_HOME/.cache" /tmp/npm-cache /tmp/* /var/tmp/*
