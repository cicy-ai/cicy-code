{
  "compilerOptions": {
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "outDir": "./dist/",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "*": ["./typings/*"]
    },
    "lib": ["dom", "es2018"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "test"
  ]
}
