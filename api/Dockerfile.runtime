ARG BASE_IMAGE=ghcr.io/cicy-ai/cicy-code-base:1.0.8
FROM ${BASE_IMAGE}

USER root

RUN set -eux; \
    printf '%s\n' \
        'Types: deb' \
        'URIs: http://mirrors.tuna.tsinghua.edu.cn/debian' \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        '' \
        'Types: deb' \
        'URIs: http://mirrors.tuna.tsinghua.edu.cn/debian-security' \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        > /etc/apt/sources.list.d/debian.sources

# supervisord is now PID 1's child (behind tini): it manages cicy-code, the
# cron daemon, the SSH server, and any user daemons — with autorestart, log
# capture, and per-program `supervisorctl restart` for hot updates. tini reaps
# zombies and forwards signals — important once arbitrary user daemons may fork
# under PID 1. cron + openssh-server let users schedule jobs and SSH in.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends supervisor tini cron openssh-server; \
    mkdir -p /etc/supervisor/conf.d /etc/ssh/sshd_config.d; \
    rm -f /etc/ssh/ssh_host_*; \
    rm -rf /var/lib/apt/lists/*

# supervisord main config + the bundled programs (cicy-code, cron, sshd). User
# daemons are added at runtime via the include dir (see supervisord.conf).
COPY supervisord.conf /etc/supervisor/supervisord.conf
COPY conf.d/ /etc/supervisor/conf.d/
# SSH policy: RSA-pubkey-only login.
COPY sshd_config.d/cicy.conf /etc/ssh/sshd_config.d/cicy.conf
# Launcher (builds argv, execs the stable symlink) + hot-update helper.
COPY cicy-code-run.sh cicy-code-update.sh /usr/local/bin/
RUN chmod 0755 /usr/local/bin/cicy-code-run.sh /usr/local/bin/cicy-code-update.sh

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
# Don't chown -R /usr/local/lib/node_modules — it doubles the layer size
# (~130MB) and cicy doesn't need write access there: global npm installs go
# to $HOME/.npm-global (configured in base via npm config set prefix).
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Optionally bake a locally-built binary: `build.sh docker` stages
# api/cicy-code-docker so DEV images (dev.py --docker) run LOCAL changes; the
# entrypoint detects this real (non-symlink) file and points the canonical
# ~/.local/bin/cicy-code symlink at it instead of npm-installing. Release / base
# builds omit the file and fall back to npm as before. Pairing the optional file
# with an always-present one (docker-entrypoint.sh) keeps this COPY valid when
# the binary is absent; the RUN then installs it only if staged.
COPY docker-entrypoint.sh cicy-code-docke[r] /tmp/cicy-stage/
RUN if [ -f /tmp/cicy-stage/cicy-code-docker ]; then \
      mkdir -p /home/cicy/.npm-global/bin && \
      install -m 0755 /tmp/cicy-stage/cicy-code-docker /home/cicy/.npm-global/bin/cicy-code && \
      chown -R cicy:cicy /home/cicy/.npm-global/bin && \
      echo "[dockerfile] baked local cicy-code binary (dev build)"; \
    else \
      echo "[dockerfile] no local binary staged; entrypoint will npm-install"; \
    fi; \
    rm -rf /tmp/cicy-stage

WORKDIR /home/cicy
# No baked cicy-code binary: this is a stable BASE environment. The entrypoint
# installs cicy-code from npm (npmmirror) at startup, so the image only needs
# rebuilding when the Dockerfile / base deps change — not on every cicy-code
# release. Pin with CICY_CODE_VERSION; the version floats with npm otherwise.
RUN set -eux; \
    mkdir -p /home/cicy/cicy-ai /home/cicy/cicy-ai/.cicy /home/cicy/cicy-ai/projects /home/cicy/cicy-ai/workers /home/cicy/cicy-ai/skills && chown -R cicy:cicy /home/cicy/cicy-ai && \
    touch /home/cicy/.bashrc && \
    grep -Fqx '[ -f "$HOME/.cicy_tmux.conf" ] && source "$HOME/.cicy_tmux.conf"' /home/cicy/.bashrc || \
      printf '%s\n' '[ -f "$HOME/.cicy_tmux.conf" ] && source "$HOME/.cicy_tmux.conf"' >> /home/cicy/.bashrc
USER cicy
# ENABLE_CDN=true makes the entrypoint launch cicy-code with --cdn, serving the
# App SPA + ttyd bundle from Cloudflare R2 (assets must be published to R2 for
# the running version). Default off → embedded local assets.
ENV HOME=/home/cicy \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    ENABLE_CDN=false \
    PATH="/home/cicy/.npm-global/bin:/home/cicy/.local/bin:/home/cicy/.opencode/bin:${PATH}"

# NOTE: claude is NOT pre-installed. Agent CLIs (claude/codex/opencode) install
# on demand only when a non-cicy agent is actually launched (bound under w-1001),
# so a fresh runtime never pays the install cost for agents the user doesn't use.

# Pre-install the mihomo proxy binary from its npm subpackage (published by the
# cicy-mihomo release CI) so containers never fetch it from GitHub releases at
# runtime — gh proxies have shipped corrupted bytes (0xC0000005) and are slow
# in CN. npm pack verifies pacote sha512 integrity.
#
# Runtime Bundle v1 (主人指令: 捆绑=安装时直接 cp 进指定目录): the binary is
# cp'd into the versioned runtime store ~/cicy-ai/runtime/mihomo/<ver>/ with a
# versions.json `current` pointer — the SAME layout cicy-desktop and the
# cicy-mihomo skill manage, so version checks/updates are uniform everywhere.
# ~/.local/bin/mihomo stays as a symlink for cicy-code's legacy probe.
# Pin via MIHOMO_NPM_VERSION; bump = rebuild base.
ARG MIHOMO_NPM_VERSION=1.10.4
RUN set -eux; \
    RT="/home/cicy/cicy-ai/runtime"; \
    mkdir -p "${RT}/mihomo/${MIHOMO_NPM_VERSION}" /home/cicy/.local/bin /tmp/mihomo-pkg; \
    cd /tmp/mihomo-pkg; \
    npm pack "cicy-mihomo-linux-x64@${MIHOMO_NPM_VERSION}" --registry=https://registry.npmmirror.com; \
    tar -xzf cicy-mihomo-linux-x64-*.tgz; \
    install -m 0755 package/mihomo "${RT}/mihomo/${MIHOMO_NPM_VERSION}/mihomo"; \
    printf '{\n  "mihomo": { "current": "%s" }\n}\n' "${MIHOMO_NPM_VERSION}" > "${RT}/versions.json"; \
    ln -sf "${RT}/mihomo/${MIHOMO_NPM_VERSION}/mihomo" /home/cicy/.local/bin/mihomo; \
    cd /; rm -rf /tmp/mihomo-pkg /tmp/npm-cache /tmp/* 2>/dev/null || true; \
    /home/cicy/.local/bin/mihomo -v | head -1

EXPOSE 8008 22
# tini as PID 1 → reaps zombies + forwards signals → docker-entrypoint.sh →
# `exec supervisord`, which runs cicy-code / cron / sshd / user daemons.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
