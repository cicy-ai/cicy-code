#!/usr/bin/env python3
"""cicy-policy — thin client for the audit-policy admin skill.

Talks to cicy-code on $PORT (default 8008), authenticated with
~/cicy-ai/global.json#api_token. Same backend the UI Audit dashboard
uses; this just gives the agent a stable command surface.

Usage:
  cicy-policy show                                  # full policy JSON
  cicy-policy summary                               # one-screen human view
  cicy-policy patch '<json>'                        # merge JSON into policy
  cicy-policy set <key.path> <value>                # set one field
  cicy-policy unset <key.path>                      # remove one field
  cicy-policy recent [--rule RULE] [--limit N]      # recent matched events
  cicy-policy history                               # git log of audit dir
  cicy-policy template list                         # curated policy templates
  cicy-policy template diff <name>                  # what a template would change
  cicy-policy template apply <name> [--yes]         # preview / apply a template
  cicy-policy channel status                        # notification channels + deliverability
  cicy-policy channel smtp --host H --port P ...    # configure SMTP (db/smtp.json)
  cicy-policy channel test --to <email>             # test-send through active channels
  cicy-policy channel wechat                        # start WeChat QR bind
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
import urllib.error
import urllib.parse
from pathlib import Path

GLOBAL_JSON = Path.home() / "cicy-ai" / "global.json"
AUDIT_DIR = Path.home() / "cicy-ai" / "audit"
TEMPLATES_DIR = Path(__file__).resolve().parent.parent / "templates"


def load_token() -> str:
    try:
        with open(GLOBAL_JSON) as f:
            tok = json.load(f).get("api_token", "")
            if tok:
                return tok
    except FileNotFoundError:
        pass
    sys.exit(f"error: api_token not found in {GLOBAL_JSON}")


def base_url() -> str:
    port = os.environ.get("PORT") or "8008"
    return f"http://127.0.0.1:{port}"


def api(method: str, path: str, body: dict | None = None, timeout: float = 15.0) -> dict:
    url = f"{base_url()}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {load_token()}")
    if body is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            if not raw:
                return {}
            return json.loads(raw)
    except urllib.error.HTTPError as e:
        sys.exit(f"error: HTTP {e.code} on {path}: {e.read().decode(errors='replace')[:400]}")
    except urllib.error.URLError as e:
        sys.exit(f"error: cannot reach {url}: {e}")


def cmd_show(_):
    policy = api("GET", "/api/audit/policy")
    print(json.dumps(policy, indent=2, ensure_ascii=False))


def cmd_summary(_):
    p = api("GET", "/api/audit/policy")
    print(f"enabled:        {p.get('enabled', True)}")
    print(f"fail_mode:      {p.get('fail_mode', 'open')}")
    ov = p.get("rules_override") or []
    cr = p.get("custom_rules") or []
    al = p.get("allow_list") or {}
    pv = p.get("preventive") or {}
    ir = p.get("incident_response") or {}
    print(f"rules_override: {len(ov)} rule(s)")
    for r in ov:
        bits = []
        if r.get("disabled"):
            bits.append("DISABLED")
        if r.get("severity"):
            bits.append(f"severity={r['severity']}")
        if r.get("default_action"):
            bits.append(f"action={r['default_action']}")
        print(f"  - {r.get('id')}  {' '.join(bits)}")
    print(f"custom_rules:   {len(cr)} rule(s)")
    for r in cr:
        m = r.get("match") or {}
        print(f"  - {r.get('id')}  severity={r.get('severity')} action={r.get('default_action','-')} "
              f"match={m.get('type','?')}({m.get('pattern','')[:40] + ('…' if len(m.get('pattern',''))>40 else '')})")
    print(f"allow_list:     paths={len(al.get('paths') or [])} hashes={len(al.get('content_hashes') or [])} agents={al.get('agents') or []}")
    print(f"preventive:     enabled={pv.get('enabled', False)} fail_mode={pv.get('fail_mode','open')}")
    print(f"incident_email: enabled={ir.get('enabled', False)} min={ir.get('trigger_min_severity','high')} cooldown={ir.get('cooldown_seconds',1800)}s")


def deep_merge(dst: dict, src: dict) -> dict:
    """Merge src into dst. Lists are *replaced*, not appended — caller passes
    the full intended list. Dicts merge key-by-key."""
    for k, v in src.items():
        if isinstance(v, dict) and isinstance(dst.get(k), dict):
            deep_merge(dst[k], v)
        else:
            dst[k] = v
    return dst


def cmd_patch(args):
    try:
        patch = json.loads(args.patch_json)
    except json.JSONDecodeError as e:
        sys.exit(f"error: invalid JSON: {e}")
    if not isinstance(patch, dict):
        sys.exit("error: patch must be a JSON object")
    current = api("GET", "/api/audit/policy")
    merged = deep_merge(current, patch)
    res = api("POST", "/api/audit/policy", merged)
    print(f"ok  hash={res.get('policy_hash','?')}")


def parse_value(v: str):
    """Parse a CLI value as JSON if possible, otherwise as string."""
    try:
        return json.loads(v)
    except json.JSONDecodeError:
        return v


def cmd_set(args):
    parts = args.key.split(".")
    val = parse_value(args.value)
    patch: dict = {}
    cur: dict = patch
    for p in parts[:-1]:
        cur[p] = {}
        cur = cur[p]
    cur[parts[-1]] = val
    args.patch_json = json.dumps(patch)
    cmd_patch(args)


def cmd_unset(args):
    parts = args.key.split(".")
    current = api("GET", "/api/audit/policy")
    cur = current
    for p in parts[:-1]:
        if not isinstance(cur, dict) or p not in cur:
            sys.exit(f"error: key {args.key!r} not present")
        cur = cur[p]
    if not isinstance(cur, dict) or parts[-1] not in cur:
        sys.exit(f"error: key {args.key!r} not present")
    del cur[parts[-1]]
    res = api("POST", "/api/audit/policy", current)
    print(f"ok  hash={res.get('policy_hash','?')}")


def cmd_recent(args):
    qs = f"limit={args.limit}"
    if args.rule:
        qs += f"&rule={args.rule}"
    if args.agent:
        qs += f"&agent_id={args.agent}"
    data = api("GET", f"/api/audit/events?{qs}")
    events = data.get("events") or []
    if not events:
        print("(no matching events)")
        return
    for e in events:
        ident = e.get("identity") or {}
        findings = e.get("findings") or []
        print(f"{e.get('ts','')}  agent={ident.get('agent_id','')}  rules={[f.get('rule_id') for f in findings]}")


def cmd_history(_):
    if not (AUDIT_DIR / ".git").exists():
        print("(no git history in ~/cicy-ai/audit — autonomy hasn't auto-committed yet)")
        return
    git = shutil.which("git")
    if not git:
        sys.exit("error: git not on PATH")
    subprocess.run([git, "-C", str(AUDIT_DIR), "log", "--oneline", "-n", "20"], check=False)


def cmd_readiness(_):
    r = api("GET", "/api/audit/readiness")
    print("响应链路就绪度:")
    print(f"  事件响应开关 (incident_enabled):  {r.get('incident_enabled')}")
    print(f"  责任人已配 (responsible_persons): {r.get('responsible_persons_configured')}")
    print(f"  邮件可投递 (mail_deliverable):    {r.get('mail_deliverable')}  [mailer={r.get('mailer_kind')}, from={r.get('email_from') or '-'}]")
    print(f"  实时拦截 (preventive):            {r.get('preventive_enabled')}")
    print(f"  AI 研判 (ai_remediation):         {r.get('ai_remediation_enabled')}")
    print(f"  IM 接入 (im_bound):               {r.get('im_bound')}")
    gaps = r.get("gaps") or []
    if gaps:
        print("缺口 (补齐才能形成响应闭环):")
        for g in gaps:
            print(f"  ✗ {g}")
    else:
        print("  ✓ 响应链路完整")


def cmd_notify(args):
    body = {"event_id": args.event_id}
    if args.note:
        body["note"] = args.note
    res = api("POST", "/api/audit/notify", body)
    print(f"ok  已通知责任人  event={res.get('event_id', args.event_id)}")


# ── policy templates (curated starting points) ──────────────────────────────

def load_template(name: str) -> dict:
    f = TEMPLATES_DIR / f"{name}.json"
    if not f.exists():
        avail = ", ".join(sorted(p.stem for p in TEMPLATES_DIR.glob("*.json"))) or "(none)"
        sys.exit(f"error: template {name!r} not found. available: {avail}")
    try:
        return json.loads(f.read_text())
    except json.JSONDecodeError as e:
        sys.exit(f"error: template {name!r} is invalid JSON: {e}")


def _render_val(v) -> str:
    if isinstance(v, list):
        ids = [x.get("id") for x in v if isinstance(x, dict) and x.get("id")]
        if ids:
            return f"[{len(v)} 条: {', '.join(ids)}]"
    return json.dumps(v, ensure_ascii=False)


def _flatten(d: dict, prefix: str = "") -> dict:
    """Flatten nested dicts to dotted keys; lists are kept as leaf values
    (deep_merge replaces lists wholesale, so we diff them as a unit)."""
    out: dict = {}
    for k, v in d.items():
        key = f"{prefix}.{k}" if prefix else k
        if isinstance(v, dict):
            out.update(_flatten(v, key))
        else:
            out[key] = v
    return out


def _template_changes(tpl: dict):
    """Return [(dotted_key, current, new), ...] for keys the template alters."""
    pol = tpl.get("policy") or {}
    current = api("GET", "/api/audit/policy")
    flat_new = _flatten(pol)
    flat_cur = _flatten(current)
    changes = []
    for k, newv in flat_new.items():
        curv = flat_cur.get(k, None)
        if curv != newv:
            changes.append((k, curv, newv))
    return changes


def _print_changes(changes):
    for k, curv, newv in changes:
        cur_s = "<未设>" if curv is None else _render_val(curv)
        print(f"  {k}:  {cur_s}  →  {_render_val(newv)}")


def cmd_template_list(_):
    files = sorted(TEMPLATES_DIR.glob("*.json"))
    if not files:
        print(f"(no templates in {TEMPLATES_DIR})")
        return
    print("可用策略模板:")
    for f in files:
        try:
            t = json.loads(f.read_text())
        except json.JSONDecodeError:
            continue
        print(f"\n  ▸ {t.get('name', f.stem)}  —  {t.get('title','')}")
        if t.get("summary"):
            print(f"    {t['summary']}")
        if t.get("use_when"):
            print(f"    适用: {t['use_when']}")
    print("\n看改动: cicy-policy template diff <name>   应用: cicy-policy template apply <name> --yes")


def cmd_template_show(args):
    print(json.dumps(load_template(args.name), indent=2, ensure_ascii=False))


def cmd_template_diff(args):
    t = load_template(args.name)
    changes = _template_changes(t)
    print(f"模板 {t.get('name')} ({t.get('title','')}) 将改动 {len(changes)} 处:")
    if not changes:
        print("  (当前策略已与模板一致,无改动)")
        return
    _print_changes(changes)
    if t.get("tradeoffs"):
        print(f"\n权衡: {t['tradeoffs']}")
    print("\n注意: 列表字段(rules_override / custom_rules)是整体替换、非追加 —— 已有自定义规则先 cicy-policy show 确认不会被覆盖。")


def cmd_template_apply(args):
    t = load_template(args.name)
    changes = _template_changes(t)
    if not changes:
        print(f"模板 {t.get('name')} 与当前策略一致,无需应用。")
        return
    if not args.yes:
        print(f"模板 {t.get('name')} ({t.get('title','')}) 将改动 {len(changes)} 处(预览,未写入):")
        _print_changes(changes)
        if t.get("tradeoffs"):
            print(f"\n权衡: {t['tradeoffs']}")
        print(f"\n确认无误后写入: cicy-policy template apply {args.name} --yes")
        return
    current = api("GET", "/api/audit/policy")
    merged = deep_merge(current, t.get("policy") or {})
    res = api("POST", "/api/audit/policy", merged)
    print(f"ok  已应用模板 {t.get('name')}  hash={res.get('policy_hash','?')}")
    print("回滚: cicy-policy unset <key.path> 逐项撤销,或 cicy-code audit autonomy revert <id>")


# ── notification channels (help the operator add SMTP / WeChat) ──────────────

DB_DIR = Path.home() / "cicy-ai" / "db"


def cmd_channel_status(_):
    r = api("GET", "/api/audit/readiness")
    print("通知渠道状态:")
    deliver = "✓ 可投递" if r.get("mail_deliverable") else "✗ 仅落盘(没人收)"
    line = f"  邮件: mailer={r.get('mailer_kind')}  {deliver}"
    if r.get("email_from"):
        line += f"  from={r.get('email_from')}"
    print(line)
    print(f"  微信: {'✓ 已绑定' if r.get('im_bound') else '✗ 未绑定'}")
    print("\n配置: cicy-policy channel smtp --host ... --port ...  |  channel wechat")
    print("验证: cicy-policy channel test --to <安全员邮箱>")


def cmd_channel_smtp(args):
    cfg = {
        "host": args.host,
        "port": args.port,
        "username": args.user or "",
        "password": args.password or "",
        "from": args.sender or args.user or "",
        "tls": args.tls or "",
    }
    DB_DIR.mkdir(parents=True, exist_ok=True)
    p = DB_DIR / "smtp.json"
    p.write_text(json.dumps(cfg, ensure_ascii=False, indent=2))
    try:
        p.chmod(0o600)
    except OSError:
        pass
    print(f"ok  已写 {p}")
    print(f"  host={cfg['host']}:{cfg['port']}  from={cfg['from']}  tls={cfg['tls'] or '(按端口推断)'}")
    print("  已触发热加载;用  cicy-policy channel test --to <安全员邮箱>  验证真发")


def cmd_channel_test(args):
    res = api("POST", "/api/audit/channels/test", {"to": args.to or ""})
    print(res.get("summary", "(无结果)"))
    if not res.get("ok"):
        print("⚠ 有渠道发送失败: " + str(res.get("error", "")))


def cmd_channel_wechat(_):
    # Pop the WeChat QR modal in the operator's browser via a WS broadcast,
    # rather than printing a QR link in this terminal. The frontend handles
    # the scan + bind; once bound, audit alerts also push to WeChat.
    res = api("POST", "/api/im/wechat/prompt")
    if res.get("ok"):
        print("已在 Dashboard 前端弹出微信扫码窗口 —— 请在浏览器里用手机微信扫码绑定。")
        print("绑定后审计告警会同时推送微信(SMTP 仍默认发)。")
    else:
        print("拉起失败: " + json.dumps(res, ensure_ascii=False)[:300])


def main():
    ap = argparse.ArgumentParser(description="Audit policy admin client.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("show").set_defaults(func=cmd_show)
    sub.add_parser("summary").set_defaults(func=cmd_summary)

    sp = sub.add_parser("patch", help="Deep-merge JSON into policy.")
    sp.add_argument("patch_json")
    sp.set_defaults(func=cmd_patch)

    sp = sub.add_parser("set", help="Set one key (dot.path).")
    sp.add_argument("key")
    sp.add_argument("value")
    sp.set_defaults(func=cmd_set)

    sp = sub.add_parser("unset", help="Remove one key (dot.path).")
    sp.add_argument("key")
    sp.set_defaults(func=cmd_unset)

    sp = sub.add_parser("recent", help="List recent events optionally filtered by rule/agent.")
    sp.add_argument("--rule")
    sp.add_argument("--agent")
    sp.add_argument("--limit", type=int, default=10)
    sp.set_defaults(func=cmd_recent)

    sub.add_parser("history").set_defaults(func=cmd_history)

    sub.add_parser("readiness").set_defaults(func=cmd_readiness)

    sp = sub.add_parser("notify", help="Escalate an event to its responsible person(s).")
    sp.add_argument("event_id")
    sp.add_argument("--note", default="", help="Advisor's own assessment, prepended to the email.")
    sp.set_defaults(func=cmd_notify)

    tp = sub.add_parser("template", help="Apply a curated policy template.")
    tpsub = tp.add_subparsers(dest="tcmd", required=True)
    tpsub.add_parser("list", help="List available templates.").set_defaults(func=cmd_template_list)
    sp = tpsub.add_parser("show", help="Print a template's full JSON.")
    sp.add_argument("name")
    sp.set_defaults(func=cmd_template_show)
    sp = tpsub.add_parser("diff", help="Show what a template would change vs current policy.")
    sp.add_argument("name")
    sp.set_defaults(func=cmd_template_diff)
    sp = tpsub.add_parser("apply", help="Preview (default) or write (--yes) a template.")
    sp.add_argument("name")
    sp.add_argument("--yes", action="store_true", help="actually write (default: preview only)")
    sp.set_defaults(func=cmd_template_apply)

    ch = sub.add_parser("channel", help="Configure notification channels (smtp/wechat).")
    chsub = ch.add_subparsers(dest="chcmd", required=True)
    chsub.add_parser("status", help="Show channel config + deliverability.").set_defaults(func=cmd_channel_status)
    sp = chsub.add_parser("smtp", help="Configure SMTP (writes db/smtp.json).")
    sp.add_argument("--host", required=True)
    sp.add_argument("--port", type=int, required=True)
    sp.add_argument("--user")
    sp.add_argument("--password")
    sp.add_argument("--from", dest="sender", help="From address (default: --user)")
    sp.add_argument("--tls", choices=["starttls", "implicit", "none"])
    sp.set_defaults(func=cmd_channel_smtp)
    sp = chsub.add_parser("test", help="Send a test alert through active channels.")
    sp.add_argument("--to", default="", help="recipient email for the test")
    sp.set_defaults(func=cmd_channel_test)
    chsub.add_parser("wechat", help="Start WeChat QR bind (scan to add WeChat channel).").set_defaults(func=cmd_channel_wechat)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
