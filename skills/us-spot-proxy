#!/usr/bin/env python3
"""
Provision a US Aliyun spot ECS instance with mihomo + vpn_us + persistent data disk.

Usage:
  us-spot-proxy                          # provision spot + attach persistent disk
  us-spot-proxy --destroy                # delete instance only, keep disk
  us-spot-proxy --destroy-all            # delete instance AND disk
  us-spot-proxy --json                   # JSON output

The persistent data disk (40GB, ~3元/月) survives instance reclaims.
When spot is recycled, just run `us-spot-proxy` again.
"""

import json, os, subprocess, sys, time
from pathlib import Path

REGION = "us-east-1"
ZONE = "us-east-1a"
INSTANCE_TYPE = "ecs.n4.small"
IMAGE_ID = "ubuntu_24_04_x64_20G_alibase_20260506.vhd"
SPOT_PRICE_LIMIT = "0.05"
DISK_SIZE = 40
DISK_CATEGORY = "cloud_efficiency"
DISK_NAME = "us-spot-proxy-data"
MIHOMO_BIN = os.path.expanduser("~/projects/cicy-mihomo/bin/mihomo-linux-amd64")
LOCAL_CONFIG = os.path.expanduser("~/cicy-ai/db/mihomo.yaml")
SSH_KEY = os.path.expanduser("~/.ssh/id_rsa")
US_SSH_HOST = "108.165.57.173"
US_SSH_PORT = "30022"
US_SSH_USER = "root"
MIHOMO_PORT = 9001
AUTH_USER = "w-1001"
AUTH_PASS = "MsZTKFsSCWrQC25d"
HOST_NAME = "us-spot-proxy"


def run(cmd, **kw):
    kw.setdefault("check", True)
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    return subprocess.run(cmd, **kw)


def run_aliyun(args):
    p = run(["aliyun"] + args, timeout=30)
    return json.loads(p.stdout)


def run_ssh(host, cmd, **kw):
    ssh_cmd = ["ssh", "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=accept-new", host, cmd]
    kw.setdefault("timeout", 60)
    kw.setdefault("check", True)
    return subprocess.run(ssh_cmd, **kw)


def find_persistent_disk():
    try:
        r = run_aliyun(["ecs", "DescribeDisks", "--region", REGION, "--DiskName", DISK_NAME, "--Status", "Available"])
        disks = r.get("Disks", {}).get("Disk", [])
        if disks:
            return disks[0]
    except Exception:
        pass
    return None


def find_running_instance():
    try:
        r = run_aliyun(["ecs", "DescribeInstances", "--region", REGION, "--InstanceName", HOST_NAME])
        for inst in r.get("Instances", {}).get("Instance", []):
            if inst["Status"] == "Running":
                return inst
    except Exception:
        pass
    return None


def destroy(remove_disk=False):
    inst = find_running_instance()
    if inst:
        inst_id = inst["InstanceId"]
        ip = inst.get("PublicIpAddress", {}).get("IpAddress", [None])[0]
        print(f"  Deleting instance {inst_id} ({ip})...")
        run_aliyun(["ecs", "DeleteInstance", "--region", REGION, "--InstanceId", inst_id, "--Force", "true"])
        print(f"  Deleted.")

    if remove_disk:
        disk = find_persistent_disk()
        if disk:
            disk_id = disk["DiskId"]
            print(f"  Deleting persistent disk {disk_id}...")
            run_aliyun(["ecs", "DeleteDisk", "--region", REGION, "--DiskId", disk_id])
            print(f"  Disk deleted.")
    else:
        disk = find_persistent_disk()
        if disk:
            print(f"  Persistent disk {disk['DiskId']} kept (available)")

    # clean local configs
    ssh_config = Path.home() / ".ssh" / "config"
    if ssh_config.exists():
        lines = ssh_config.read_text().splitlines()
        kept, skip = [], False
        for line in lines:
            if line.strip().startswith(f"Host {HOST_NAME}"):
                skip = True
                continue
            if skip and line.startswith("Host "):
                skip = False
            if not skip:
                kept.append(line)
        ssh_config.write_text("\n".join(kept) + "\n")
        print(f"  Cleaned ~/.ssh/config")

    local_cfg = Path(LOCAL_CONFIG)
    if local_cfg.exists():
        content = local_cfg.read_text()
        if HOST_NAME in content:
            lines = content.split("\n")
            kept, skip = [], False
            for line in lines:
                if f'- name: "{HOST_NAME}"' in line:
                    skip = True
                if skip and line.strip().startswith("- name:") and f'"{HOST_NAME}"' not in line:
                    skip = False
                if skip and line.strip().startswith("proxy-groups:"):
                    skip = False
                if not skip:
                    kept.append(line)
            local_cfg.write_text("\n".join(kept))
            subprocess.run(["cicy-mihomo", "reload"], timeout=10, capture_output=True)
            print(f"  Cleaned {HOST_NAME} from local mihomo.yaml")

    print("\nDone.")


def main():
    if "--destroy-all" in sys.argv:
        destroy(remove_disk=True)
        return
    if "--destroy" in sys.argv:
        destroy(remove_disk=False)
        return

    # check if already running
    existing = find_running_instance()
    if existing:
        ip = existing.get("PublicIpAddress", {}).get("IpAddress", [None])[0]
        print(f"  {HOST_NAME} already running at {ip}")
        return

    output_json = "--json" in sys.argv

    # 1. ensure persistent disk
    disk = find_persistent_disk()
    if disk:
        disk_id = disk["DiskId"]
        print(f"=== Using existing persistent disk: {disk_id} ===")
    else:
        print("=== Creating persistent disk (40GB cloud_efficiency)... ===")
        disk = run_aliyun(["ecs", "CreateDisk", "--region", REGION, "--ZoneId", ZONE,
                           "--DiskName", DISK_NAME, "--Size", str(DISK_SIZE),
                           "--DiskCategory", DISK_CATEGORY])
        disk_id = disk["DiskId"]
        print(f"  Created disk: {disk_id}")
        time.sleep(5)

    # 2. create VPC + VSwitch + SG if needed
    print("=== Creating VPC... ===")
    vpc = run_aliyun(["vpc", "CreateVpc", "--region", REGION, "--CidrBlock", "172.17.0.0/16", "--VpcName", "us-spot-proxy"])
    vpc_id = vpc["VpcId"]
    time.sleep(2)
    vsw = run_aliyun(["vpc", "CreateVSwitch", "--region", REGION, "--ZoneId", ZONE, "--CidrBlock", "172.17.0.0/24", "--VpcId", vpc_id, "--VSwitchName", "us-spot-proxy"])
    vsw_id = vsw["VSwitchId"]
    sg = run_aliyun(["ecs", "CreateSecurityGroup", "--region", REGION, "--SecurityGroupName", "us-spot-proxy-sg", "--VpcId", vpc_id])
    sg_id = sg["SecurityGroupId"]
    run_aliyun(["ecs", "AuthorizeSecurityGroup", "--region", REGION, "--SecurityGroupId", sg_id, "--IpProtocol", "tcp", "--PortRange", "22/22", "--SourceCidrIp", "0.0.0.0/0", "--Description", "SSH"])
    run_aliyun(["ecs", "AuthorizeSecurityGroup", "--region", REGION, "--SecurityGroupId", sg_id, "--IpProtocol", "tcp", "--PortRange", f"{MIHOMO_PORT}/{MIHOMO_PORT}", "--SourceCidrIp", "0.0.0.0/0", "--Description", "mihomo"])

    # 3. import key
    run_aliyun(["ecs", "ImportKeyPair", "--region", REGION, "--KeyPairName", "us-spot-proxy-key", "--PublicKeyBody", Path(SSH_KEY).with_suffix(".pub").read_text().strip()])

    # 4. create spot instance
    print("=== Creating spot instance... ===")
    inst = run_aliyun(["ecs", "RunInstances", "--region", REGION, "--ZoneId", ZONE,
                       "--InstanceType", INSTANCE_TYPE, "--ImageId", IMAGE_ID,
                       "--SecurityGroupId", sg_id, "--VSwitchId", vsw_id,
                       "--InstanceChargeType", "PostPaid",
                       "--SpotStrategy", "SpotWithPriceLimit",
                       "--SpotPriceLimit", SPOT_PRICE_LIMIT,
                       "--InternetChargeType", "PayByTraffic",
                       "--InternetMaxBandwidthOut", "100",
                       "--SystemDisk.Category", "cloud_efficiency",
                       "--SystemDisk.Size", "20",
                       "--InstanceName", HOST_NAME, "--HostName", HOST_NAME,
                       "--KeyPairName", "us-spot-proxy-key", "--Amount", "1"])
    inst_id = inst["InstanceIdSets"]["InstanceIdSet"][0]
    print(f"  Instance: {inst_id}")

    # 5. wait for IP
    print("=== Waiting for IP... ===")
    for i in range(12):
        time.sleep(10)
        desc = run_aliyun(["ecs", "DescribeInstances", "--region", REGION, "--InstanceIds", json.dumps([inst_id])])
        inst_info = desc["Instances"]["Instance"][0]
        ips = inst_info.get("PublicIpAddress", {}).get("IpAddress", [])
        if ips:
            ip = ips[0]
            print(f"  IP: {ip}")
            break
    else:
        print("ERROR: timeout waiting for IP"); sys.exit(1)

    # 6. attach persistent disk
    print("=== Attaching persistent disk... ===")
    run_aliyun(["ecs", "AttachDisk", "--region", REGION, "--InstanceId", inst_id, "--DiskId", disk_id])
    time.sleep(5)

    # 7. add SSH config
    entry = f"\nHost {HOST_NAME}\n    HostName {ip}\n    User root\n    Port 22\n    IdentityFile {SSH_KEY}\n"
    ssh_config = Path.home() / ".ssh" / "config"
    if f"Host {HOST_NAME}" not in ssh_config.read_text():
        ssh_config.write_text(ssh_config.read_text().rstrip() + entry)

    # 8. wait for SSH
    print("=== Waiting for SSH... ===")
    for i in range(12):
        time.sleep(5)
        p = run(["ssh", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=accept-new", HOST_NAME, "echo ready"], check=False, capture_output=True)
        if p.returncode == 0:
            break
    else:
        print("ERROR: SSH timeout"); sys.exit(1)

    # 9. install autossh, format+ mount disk
    print("=== Setting up instance... ===")
    run_ssh(HOST_NAME, "apt-get update -qq && apt-get install -y -qq autossh")
    run_ssh(HOST_NAME,
        'DISK_DEV=$(lsblk -ndo NAME,MOUNTPOINT | grep "^vd" | grep -v "^vda" | awk "{print \\$1}"); '
        'if [ -n "$DISK_DEV" ]; then '
        '  mkfs.ext4 -F /dev/$DISK_DEV 2>/dev/null; '
        '  mkdir -p /data; '
        '  mount /dev/$DISK_DEV /data; '
        '  echo "/dev/$DISK_DEV /data ext4 defaults 0 0" >> /etc/fstab; '
        'fi; '
        'mkdir -p /data/mihomo')

    # 10. generate SSH key for vpn_us tunnel
    pub = run_ssh(HOST_NAME, "ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N '' -q && cat ~/.ssh/id_ed25519.pub")
    run(["ssh", "-p", US_SSH_PORT, "-o", "StrictHostKeyChecking=accept-new", f"{US_SSH_USER}@{US_SSH_HOST}",
         f"echo '{pub.stdout.strip()}' >> ~/.ssh/authorized_keys"], timeout=10)

    # 11. transfer mihomo
    print("=== Transferring mihomo... ===")
    run(["bash", "-c", f"cat {MIHOMO_BIN} | ssh {HOST_NAME} 'cat > /data/mihomo/mihomo && chmod +x /data/mihomo/mihomo'"], timeout=180)
    run_ssh(HOST_NAME, "ln -sf /data/mihomo/mihomo /usr/local/bin/mihomo")

    # 12. start tunnel
    print("=== Starting autossh tunnel... ===")
    run_ssh(HOST_NAME,
        "autossh -M 0 -N -f -D 0.0.0.0:1084 "
        f"-i ~/.ssh/id_ed25519 -p {US_SSH_PORT} "
        "-o BatchMode=yes -o ConnectTimeout=8 -o ExitOnForwardFailure=yes "
        "-o StrictHostKeyChecking=accept-new -o TCPKeepAlive=yes "
        "-o ServerAliveInterval=15 -o ServerAliveCountMax=3 "
        f"{US_SSH_USER}@{US_SSH_HOST}")

    # 13. write mihomo config on persistent disk
    print("=== Writing mihomo config... ===")
    run_ssh(HOST_NAME, f"""cat > /data/mihomo/config.yaml << CFG
mixed-port: {MIHOMO_PORT}
allow-lan: true
bind-address: 0.0.0.0
mode: rule
log-level: info

external-controller: 127.0.0.1:18009

authentication:
  - "{AUTH_USER}:{AUTH_PASS}"

proxies:
  - name: "vpn_us"
    type: socks5
    server: 127.0.0.1
    port: 1084

rules:
  - MATCH,vpn_us
CFG""")

    # 14. start mihomo from persistent disk
    print("=== Starting mihomo... ===")
    run_ssh(HOST_NAME,
        "pkill -9 -f mihomo 2>/dev/null; sleep 1; "
        "nohup /data/mihomo/mihomo -d /data/mihomo > /data/mihomo/mihomo.log 2>&1 & disown")
    time.sleep(8)

    # 15. test
    test = run_ssh(HOST_NAME,
        f"curl -sS -o /dev/null -w '%{{http_code}} %{{time_total}}s' --connect-timeout 10 "
        f"-x http://{AUTH_USER}:{AUTH_PASS}@127.0.0.1:{MIHOMO_PORT} https://api.myip.com",
        check=False)
    print(f"  Test: {test.stdout}")

    # 16. add to local mihomo.yaml
    local_cfg = Path(LOCAL_CONFIG)
    if local_cfg.exists():
        content = local_cfg.read_text()
        node = f"""  - name: "{HOST_NAME}"
    type: http
    server: {ip}
    port: {MIHOMO_PORT}
    username: {AUTH_USER}
    password: {AUTH_PASS}
    skip-cert-verify: true
"""
        if HOST_NAME not in content:
            idx = content.rfind("  - name:")
            if idx > 0:
                insert_at = content.find("\n", content.find("\n", idx) + 1)
                if insert_at > 0:
                    insert_at = content.find("\n", insert_at + 1)
                if insert_at > 0:
                    insert_at = content.find("\nproxy-groups:", idx)
                if insert_at < 0:
                    insert_at = len(content)
                content = content[:insert_at] + "\n" + node + content[insert_at:]
            local_cfg.write_text(content)
            subprocess.run(["cicy-mihomo", "reload"], timeout=10)
            print(f"  Added {HOST_NAME} to local mihomo.yaml")

    result = {
        "instance_id": inst_id, "ip": ip, "disk_id": disk_id,
        "region": REGION, "zone": ZONE, "type": INSTANCE_TYPE,
        "config": f"http://{AUTH_USER}:{AUTH_PASS}@{ip}:{MIHOMO_PORT}",
    }
    if output_json:
        print(json.dumps(result, indent=2))
    else:
        print(f"\n=== Done ===")
        print(f"  {HOST_NAME} -> {ip}:{MIHOMO_PORT}")
        print(f"  Disk {disk_id} persists across instance reclaims")
        print(f"  Rebuild: us-spot-proxy")
        print(f"  Destroy instance only: us-spot-proxy --destroy")
        print(f"  Destroy all (incl disk): us-spot-proxy --destroy-all")


if __name__ == "__main__":
    main()
