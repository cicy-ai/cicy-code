#!/usr/bin/env bash
# cicy-todo — manage per-workspace todos via cicy-code's /api/todo/* endpoints.
# Data lives at <workspace>/.cicy/todos.yaml (one file per pane).

set -euo pipefail

GLOBAL_JSON="${CICY_GLOBAL_JSON:-$HOME/cicy-ai/global.json}"

# ── helpers ────────────────────────────────────────────────────────────────

die() { printf >&2 'cicy-todo: %s\n' "$1"; exit "${2:-1}"; }

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1" 1; }

resolve_token() {
  if [[ -n "${CICY_API_TOKEN:-}" ]]; then
    printf '%s' "$CICY_API_TOKEN"; return
  fi
  [[ -f "$GLOBAL_JSON" ]] || die "missing $GLOBAL_JSON and CICY_API_TOKEN not set" 3
  local t
  t="$(jq -r '.api_token // empty' "$GLOBAL_JSON" 2>/dev/null || true)"
  [[ -n "$t" && "$t" != "null" ]] || die "api_token not found in $GLOBAL_JSON" 3
  printf '%s' "$t"
}

resolve_port() {
  printf '%s' "${CICY_API_PORT:-8008}"
}

resolve_pane() {
  printf '%s' "${PANE_OVERRIDE:-${CICY_PANE_ID:-w-10001}}"
}

base_url() {
  printf 'http://127.0.0.1:%s/api/todo' "$(resolve_port)"
}

# api METHOD PATH [BODY-JSON]
# Every request carries X-Agent-Show-Id: <pane> so the backend knows which
# agent's todos to act on, regardless of which pane the CLI is invoked from.
api() {
  local method="$1" path="$2" body="${3:-}"
  local url token pane http_code resp tmp
  url="$(base_url)$path"
  token="$(resolve_token)"
  pane="$(resolve_pane)"
  tmp="$(mktemp)"
  if [[ -n "$body" ]]; then
    http_code=$(curl -sS -o "$tmp" -w '%{http_code}' \
      -X "$method" \
      -H "Authorization: Bearer $token" \
      -H "Content-Type: application/json" \
      -H "X-Agent-Show-Id: $pane" \
      -d "$body" \
      "$url" || echo 000)
  else
    http_code=$(curl -sS -o "$tmp" -w '%{http_code}' \
      -X "$method" \
      -H "Authorization: Bearer $token" \
      -H "X-Agent-Show-Id: $pane" \
      "$url" || echo 000)
  fi
  resp="$(cat "$tmp")"
  rm -f "$tmp"
  case "$http_code" in
    000)        die "cannot reach cicy-code at $(base_url) — is the server running?" 3 ;;
    401|403)   die "auth failed (HTTP $http_code) — check api_token" 3 ;;
    404)
      local detail; detail="$(jq -r '.detail // empty' <<<"$resp" 2>/dev/null || true)"
      die "${detail:-not found}" 2 ;;
    2*)         printf '%s' "$resp" ;;
    *)
      local detail; detail="$(jq -r '.detail // empty' <<<"$resp" 2>/dev/null || true)"
      die "HTTP $http_code: ${detail:-$resp}" 1 ;;
  esac
}

emit_json_or() {
  if [[ "${JSON_OUT:-0}" == "1" ]]; then
    printf '%s\n' "$1"
  else
    eval "$2"
  fi
}

# ── pretty printing ────────────────────────────────────────────────────────

short_id() { local id="$1"; printf '%s' "${id:0:10}"; }

human_time() {
  # arg: iso8601 utc. Output: "刚刚 / Nm前 / Nh前 / N天前 / YYYY-MM-DD"
  local iso="$1" now sec diff
  [[ -z "$iso" || "$iso" == "null" ]] && { printf -- '-'; return; }
  now=$(date +%s)
  sec=$(date -d "$iso" +%s 2>/dev/null || echo "$now")
  diff=$(( now - sec ))
  if   (( diff < 60   )); then printf '刚刚'
  elif (( diff < 3600 )); then printf '%dm前' $(( diff / 60 ))
  elif (( diff < 86400 )); then printf '%dh前' $(( diff / 3600 ))
  elif (( diff < 604800 )); then printf '%d天前' $(( diff / 86400 ))
  else date -d "$iso" '+%Y-%m-%d'
  fi
}

status_glyph() {
  case "$1" in
    todo)    printf '○' ;;
    doing)   printf '◐' ;;
    done)    printf '✓' ;;
    dropped) printf '✗' ;;
    *)       printf '?' ;;
  esac
}

print_table() {
  # reads JSON array from stdin
  local rows; rows="$(cat)"
  local n; n=$(jq 'length' <<<"$rows")
  if [[ "$n" == 0 ]]; then
    printf '(no todos)\n'
    return
  fi
  printf '%-3s %-12s %-7s %-10s %s\n' '' 'ID' 'STATUS' 'UPDATED' 'TITLE'
  local i=0
  while (( i < n )); do
    local id title status updated glyph
    id=$(jq -r ".[$i].id"         <<<"$rows")
    title=$(jq -r ".[$i].title"   <<<"$rows")
    status=$(jq -r ".[$i].status" <<<"$rows")
    updated=$(jq -r ".[$i].updated_at" <<<"$rows")
    glyph=$(status_glyph "$status")
    printf '%-3s %-12s %-7s %-10s %s\n' "$glyph" "$(short_id "$id")" "$status" "$(human_time "$updated")" "$title"
    i=$(( i + 1 ))
  done
}

# ── commands ───────────────────────────────────────────────────────────────

cmd_add() {
  local title="${1:-}"
  [[ -n "$title" ]] || die "usage: cicy-todo [<pane>] add \"<title>\"" 1
  local body resp
  body=$(jq -nc --arg title "$title" '{title:$title}')
  resp="$(api POST /add "$body")"
  emit_json_or "$resp" 'jq -r "[.todo] | .[] | \"+ \" + .id + \"  \" + .title" <<<"$resp"'
}

cmd_list() {
  local status="" q="" all=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) status="${2:-}"; shift 2 ;;
      --status=*) status="${1#--status=}"; shift ;;
      -q|--query) q="${2:-}"; shift 2 ;;
      --all) all=1; shift ;;
      *) die "unknown arg: $1" 1 ;;
    esac
  done
  local query=""
  [[ -n "$status" ]] && query+="status=$status"
  [[ -n "$q"      ]] && { [[ -n "$query" ]] && query+="&"; query+="q=$(printf '%s' "$q" | jq -sRr @uri)"; }
  local path="/list"
  [[ -n "$query" ]] && path="/list?$query"
  local resp; resp="$(api GET "$path")"
  if [[ "${JSON_OUT:-0}" == 1 ]]; then
    printf '%s\n' "$resp"; return
  fi
  local todos
  todos=$(jq '.todos' <<<"$resp")
  if [[ "$all" == 0 && -z "$status" ]]; then
    todos=$(jq '[.[] | select(.status=="todo" or .status=="doing")]' <<<"$todos")
  fi
  printf '%s' "$todos" | print_table
}

cmd_show() {
  local id="${1:-}"; [[ -n "$id" ]] || die "usage: cicy-todo show <id>" 1
  local resp
  resp="$(api GET "/list")"
  local match
  match=$(jq --arg p "$id" '[.todos[] | select(.id==$p or (.id|startswith($p)))]' <<<"$resp")
  local n; n=$(jq 'length' <<<"$match")
  case "$n" in
    0) die "no todo matches '$id'" 2 ;;
    1) ;;
    *) printf >&2 'ambiguous prefix, candidates:\n'; jq -r '.[] | "  " + .id + "  " + .title' <<<"$match" >&2; exit 4 ;;
  esac
  emit_json_or "$(jq '.[0]' <<<"$match")" 'jq -r ".[0] | \"id:         \" + .id + \"\\nstatus:     \" + .status + \"\\ncreated:    \" + .created_at + \"\\nupdated:    \" + .updated_at + \"\\ntitle:      \" + .title" <<<"$match"'
}

# transition helper: cicy-todo done <id>
cmd_set_status() {
  local new="$1" id="${2:-}"
  [[ -n "$id" ]] || die "usage: cicy-todo $new <id>" 1
  local full body out
  full=$(_resolve_id "$id")
  body=$(jq -nc --arg s "$new" '{status:$s}')
  out="$(api PATCH "/$full" "$body")"
  emit_json_or "$out" 'jq -r ".todo | \"~ \" + .id + \"  \" + .status + \"  \" + .title" <<<"$out"'
}

cmd_edit() {
  local id="${1:-}" title="${2:-}"
  [[ -n "$id" && -n "$title" ]] || die 'usage: cicy-todo edit <id> "<new title>"' 1
  local full body out
  full=$(_resolve_id "$id")
  body=$(jq -nc --arg t "$title" '{title:$t}')
  out="$(api PATCH "/$full" "$body")"
  emit_json_or "$out" 'jq -r ".todo | \"~ \" + .id + \"  \" + .title" <<<"$out"'
}

cmd_rm() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cicy-todo rm <id>" 1
  local full out
  full=$(_resolve_id "$id")
  out="$(api DELETE "/$full")"
  emit_json_or "$out" "printf '- %s\\n' '$full'"
}

# resolve a possibly-prefix id to the full id (errors with exit 4 on ambiguity)
_resolve_id() {
  local id="$1" resp match n
  resp="$(api GET "/list")"
  match=$(jq --arg p "$id" '[.todos[] | select(.id==$p or (.id|startswith($p))) | .id]' <<<"$resp")
  n=$(jq 'length' <<<"$match")
  case "$n" in
    0) die "no todo matches '$id'" 2 ;;
    1) jq -r '.[0]' <<<"$match" ;;
    *) printf >&2 'ambiguous prefix, candidates:\n'; jq -r '.[] | "  " + .' <<<"$match" >&2; exit 4 ;;
  esac
}

usage() {
  cat <<'EOF'
cicy-todo — per-workspace todo list (todo / doing / done / dropped)

Self vs other agent:
  cicy-todo                       # list own active todos (own = $CICY_PANE_ID)
  cicy-todo w-10001               # list w-10001's active todos
  cicy-todo w-10001 add "ship it" # add a todo to w-10001
  cicy-todo w-10001 done t-1779   # mark w-10001's todo done

Subcommands:
  [pane] add "<title>"
  [pane] list [--status=todo|doing|done|dropped|all] [-q <kw>] [--all]
  [pane] show <id>
  [pane] start <id>          # → doing
  [pane] done  <id>          # → done
  [pane] drop  <id>          # → dropped
  [pane] back  <id>          # → todo
  [pane] edit  <id> "<title>"
  [pane] rm    <id>

The leading positional `pane` (e.g. `w-10001`) is optional. Without it, the
command targets the current pane ($CICY_PANE_ID, else w-10001). Every request
carries `X-Agent-Show-Id: <pane>` so the backend knows whose todos to act on.

Global flags (before subcommand):
  --pane <w-xxxxx>    same as the positional pane arg
  --json              emit raw JSON instead of formatted output
  -h, --help          show this help

Data: <workspace>/.cicy/todos.yaml (managed via /api/todo)
EOF
}

# ── arg parse ───────────────────────────────────────────────────────────────

need_cmd jq
need_cmd curl

PANE_OVERRIDE=""
JSON_OUT=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pane) PANE_OVERRIDE="${2:-}"; shift 2 ;;
    --pane=*) PANE_OVERRIDE="${1#--pane=}"; shift ;;
    --json) JSON_OUT=1; shift ;;
    -h|--help|help) usage; exit 0 ;;
    -*) die "unknown global flag: $1" 1 ;;
    *) break ;;
  esac
done

# First positional arg may be a pane id (e.g. w-10001) — treat as target pane
# unless it's already a known subcommand.
if [[ $# -gt 0 && "$1" =~ ^w-[0-9]+$ ]]; then
  PANE_OVERRIDE="$1"; shift
fi

# Default subcommand when none given: list own active todos.
sub="${1:-list}"
shift || true

case "$sub" in
  add)    cmd_add "$@" ;;
  list|ls) cmd_list "$@" ;;
  show)   cmd_show "$@" ;;
  start)  cmd_set_status doing  "$@" ;;
  done)   cmd_set_status done   "$@" ;;
  drop)   cmd_set_status dropped "$@" ;;
  back)   cmd_set_status todo   "$@" ;;
  edit)   cmd_edit "$@" ;;
  rm)     cmd_rm "$@" ;;
  *)      die "unknown subcommand: $sub (try 'cicy-todo help')" 1 ;;
esac
