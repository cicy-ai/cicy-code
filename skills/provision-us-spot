#!/usr/bin/env python3
"""
Provision a US Aliyun spot (preemptible) ECS instance with mihomo + vpn_us tunnel.

Usage:
  ./provision-us-spot                    # provision and configure
  ./provision-us-spot --json             # print JSON output
  ./provision-us-spot --region us-west-1 # override region (default: us-east-1)

Requirements:
  - aliyun CLI configured (aliyun configure set)
  - SSH key at ~/.ssh/id_rsa.pub registered in Aliyun
  - ~/projects/cicy-mihomo/bin/mihomo-linux-amd64 compiled
  - vpn_us US server (108.165.57.173:30022) accessible from new instance

Steps:
  1. Create VPC + VSwitch + SecurityGroup in target region
  2. Import SSH key
  3. Create spot (preemptible) instance
  4. Wait for IP assignment
  5. SSH in, install autossh, set up SSH tunnel to vpn_us
  6. Transfer and start mihomo
  7. Add node to local ~/cicy-ai/db/mihomo.yaml
  8. Test connectivity
"""

import json, os, subprocess, sys, time
from pathlib import Path

REGION = "us-east-1"
ZONE = "us-east-1a"
INSTANCE_TYPE = "ecs.n4.small"
IMAGE_ID = "ubuntu_24_04_x64_20G_alibase_20260506.vhd"
SPOT_PRICE_LIMIT = "0.05"
MIHOMO_BIN = os.path.expanduser("~/projects/cicy-mihomo/bin/mihomo-linux-amd64")
LOCAL_CONFIG = os.path.expanduser("~/cicy-ai/db/mihomo.yaml")
SSH_KEY = os.path.expanduser("~/.ssh/id_rsa")
US_SSH_HOST = "108.165.57.173"
US_SSH_PORT = "30022"
US_SSH_USER = "root"
MIHOMO_PORT = 9001
AUTH_USER = "w-10001"
AUTH_PASS = "MsZTKFsSCWrQC25d"


def run(cmd, **kw):
    kw.setdefault("check", True)
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    return subprocess.run(cmd, **kw)


def run_aliyun(args):
    p = run(["aliyun"] + args, timeout=30)
    return json.loads(p.stdout)


def run_ssh(host, cmd, **kw):
    ssh_cmd = ["ssh", "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=accept-new", host, cmd]
    kw.setdefault("timeout", 60)
    kw.setdefault("check", True)
    return subprocess.run(ssh_cmd, **kw)


def main():
    args = sys.argv[1:]
    output_json = "--json" in args

    print("=== 1. Creating VPC...")
    vpc = run_aliyun(["vpc", "CreateVpc", "--region", REGION, "--CidrBlock", "172.16.0.0/16", "--VpcName", "provision-us"])
    vpc_id = vpc["VpcId"]
    time.sleep(2)

    print("=== 2. Creating VSwitch...")
    vsw = run_aliyun(["vpc", "CreateVSwitch", "--region", REGION, "--ZoneId", ZONE, "--CidrBlock", "172.16.0.0/24", "--VpcId", vpc_id, "--VSwitchName", "provision-us"])
    vsw_id = vsw["VSwitchId"]

    print("=== 3. Creating SecurityGroup...")
    sg = run_aliyun(["ecs", "CreateSecurityGroup", "--region", REGION, "--SecurityGroupName", "provision-us-sg", "--VpcId", vpc_id])
    sg_id = sg["SecurityGroupId"]
    run_aliyun(["ecs", "AuthorizeSecurityGroup", "--region", REGION, "--SecurityGroupId", sg_id, "--IpProtocol", "tcp", "--PortRange", "22/22", "--SourceCidrIp", "0.0.0.0/0", "--Description", "SSH"])
    run_aliyun(["ecs", "AuthorizeSecurityGroup", "--region", REGION, "--SecurityGroupId", sg_id, "--IpProtocol", "tcp", "--PortRange", f"{MIHOMO_PORT}/{MIHOMO_PORT}", "--SourceCidrIp", "0.0.0.0/0", "--Description", "mihomo"])

    print("=== 4. Importing SSH key...")
    pubkey = Path(SSH_KEY).with_suffix(".pub").read_text().strip()
    run_aliyun(["ecs", "ImportKeyPair", "--region", REGION, "--KeyPairName", "provision-us-key", "--PublicKeyBody", pubkey])

    print("=== 5. Creating spot instance...")
    inst = run_aliyun(["ecs", "RunInstances",
        "--region", REGION, "--ZoneId", ZONE,
        "--InstanceType", INSTANCE_TYPE,
        "--ImageId", IMAGE_ID,
        "--SecurityGroupId", sg_id,
        "--VSwitchId", vsw_id,
        "--InstanceChargeType", "PostPaid",
        "--SpotStrategy", "SpotWithPriceLimit",
        "--SpotPriceLimit", SPOT_PRICE_LIMIT,
        "--InternetChargeType", "PayByTraffic",
        "--InternetMaxBandwidthOut", "100",
        "--SystemDisk.Category", "cloud_efficiency",
        "--SystemDisk.Size", "40",
        "--InstanceName", "us-spot",
        "--HostName", "us-spot",
        "--KeyPairName", "provision-us-key",
        "--Amount", "1"])
    inst_id = inst["InstanceIdSets"]["InstanceIdSet"][0]
    print(f"  Instance ID: {inst_id}")

    print("=== 6. Waiting for IP...")
    for i in range(12):
        time.sleep(10)
        desc = run_aliyun(["ecs", "DescribeInstances", "--region", REGION, "--InstanceIds", json.dumps([inst_id])])
        inst_info = desc["Instances"]["Instance"][0]
        ips = inst_info.get("PublicIpAddress", {}).get("IpAddress", [])
        if ips:
            ip = ips[0]
            print(f"  IP: {ip}")
            break
    else:
        print("ERROR: timeout waiting for IP")
        sys.exit(1)

    # write to SSH config
    ssh_config = Path.home() / ".ssh" / "config"
    entry = f"\nHost us-spot\n    HostName {ip}\n    User root\n    Port 22\n    IdentityFile {SSH_KEY}\n"
    if "Host us-spot" not in ssh_config.read_text():
        ssh_config.write_text(ssh_config.read_text().rstrip() + entry)

    print("=== 7. Waiting for SSH...")
    for i in range(12):
        time.sleep(5)
        p = run(["ssh", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=accept-new", "us-spot", "echo ready"], check=False, capture_output=True, timeout=10)
        if p.returncode == 0:
            break
    else:
        print("ERROR: SSH timeout")
        sys.exit(1)

    print("=== 8. Installing autossh...")
    run_ssh("us-spot", "apt-get update -qq && apt-get install -y -qq autossh")

    print("=== 9. Generating SSH key + adding to US server...")
    pub = run_ssh("us-spot", "ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N '' -q && cat ~/.ssh/id_ed25519.pub", capture_output=True, text=True)
    run(["ssh", "-p", US_SSH_PORT, "-o", "StrictHostKeyChecking=accept-new", f"{US_SSH_USER}@{US_SSH_HOST}",
         f"echo '{pub.stdout.strip()}' >> ~/.ssh/authorized_keys"], timeout=10, check=True)

    print("=== 10. Transferring mihomo binary...")
    run(["bash", "-c", f"cat {MIHOMO_BIN} | ssh us-spot 'cat > /usr/local/bin/mihomo && chmod +x /usr/local/bin/mihomo'"], timeout=120)

    print("=== 11. Starting autossh tunnel to US server...")
    run_ssh("us-spot",
        "autossh -M 0 -N -f -D 0.0.0.0:1084 "
        f"-i ~/.ssh/id_ed25519 -p {US_SSH_PORT} "
        "-o BatchMode=yes -o ConnectTimeout=8 -o ExitOnForwardFailure=yes "
        "-o StrictHostKeyChecking=accept-new -o TCPKeepAlive=yes "
        "-o ServerAliveInterval=15 -o ServerAliveCountMax=3 "
        f"{US_SSH_USER}@{US_SSH_HOST}")

    print("=== 12. Writing mihomo config...")
    config_yaml = f"""mixed-port: {MIHOMO_PORT}
allow-lan: true
bind-address: 0.0.0.0
mode: rule
log-level: info

external-controller: 127.0.0.1:18009

authentication:
  - "{AUTH_USER}:{AUTH_PASS}"

proxies:
  - name: "vpn_us"
    type: socks5
    server: 127.0.0.1
    port: 1084

rules:
  - MATCH,vpn_us
"""
    run_ssh("us-spot", f"mkdir -p /root/cicy-ai/db && cat > /root/cicy-ai/db/config.yaml << 'CONFIGEOF'\n{config_yaml}CONFIGEOF")

    print("=== 13. Starting mihomo...")
    run_ssh("us-spot", "pkill -9 -f mihomo 2>/dev/null; sleep 1; "
                       "nohup /usr/local/bin/mihomo -d /root/cicy-ai/db > /root/cicy-ai/db/mihomo.log 2>&1 & disown")

    print("=== 14. Testing...")
    time.sleep(4)
    test = run_ssh("us-spot",
        f"curl -sS -o /dev/null -w '%{{http_code}}' --connect-timeout 10 "
        f"-x http://{AUTH_USER}:{AUTH_PASS}@127.0.0.1:{MIHOMO_PORT} https://api.myip.com",
        capture_output=True, text=True)
    print(f"  Test result: {test.stdout}")

    # add to local mihomo config
    local_cfg = Path(LOCAL_CONFIG)
    if local_cfg.exists():
        content = local_cfg.read_text()
        node_entry = f"""  - name: "us-spot"
    type: http
    server: {ip}
    port: {MIHOMO_PORT}
    username: {AUTH_USER}
    password: {AUTH_PASS}
    skip-cert-verify: true
"""
        if "us-spot" not in content:
            # insert after last proxy in proxies section
            idx = content.rfind("  - name:")
            if idx > 0:
                insert_at = content.find("\n\n", idx)
                if insert_at < 0:
                    insert_at = content.find("\nproxy-groups:", idx)
                if insert_at > 0:
                    content = content[:insert_at] + "\n" + node_entry + content[insert_at:]
            local_cfg.write_text(content)
            print("  Added us-spot to local mihomo.yaml")
            subprocess.run(["cicy-mihomo", "reload"], timeout=10, capture_output=True)
        else:
            print("  us-spot already in local mihomo.yaml")

    result = {
        "instance_id": inst_id,
        "ip": ip,
        "region": REGION,
        "zone": ZONE,
        "type": INSTANCE_TYPE,
        "vpc_id": vpc_id,
        "vswitch_id": vsw_id,
        "sg_id": sg_id,
        "status": "provisioned",
        "config": f"http://{AUTH_USER}:{AUTH_PASS}@{ip}:{MIHOMO_PORT}",
    }
    if output_json:
        print(json.dumps(result, indent=2))
    else:
        print(f"\n=== Done ===")
        print(f"  us-spot -> {ip}:{MIHOMO_PORT}")
        print(f"  auth: {AUTH_USER}:{AUTH_PASS}")
        print(f"  To remove: aliyun ecs DeleteInstance --region {REGION} --InstanceId {inst_id} --Force true")


if __name__ == "__main__":
    main()
