#!/usr/bin/env bash
# skill-author — manage user-authored Claude/Codex/OpenCode skills
# under ~/cicy-ai/skills/<name>/

set -euo pipefail

SKILLS_ROOT="${HOME}/cicy-ai/skills"
PROFILES=(.claude .codex .opencode)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SELF_ROOT="$(dirname "$SCRIPT_DIR")"  # ~/cicy-ai/skills/cicy-skills/skill-author
TEMPLATES_DIR="${SELF_ROOT}/templates"

# ── Reserved names ──────────────────────────────────────────────────────────
# Built-in skills generated by cicy-skills (the Go binary). Users cannot
# create or remove these via skill-author. Keep aligned with
# api/mgr/skills.go::agentgenApprovedMarketSkills.
BUILTIN_SKILLS=(
  agent-code-server agent-summary agent-webpage
  cf cf-tunnel cping
  frp-client frp-server
  globalApiToken google cicy-ssh cicy-agent cicy-mihomo
  us-spot-proxy us-spot-dev hk-spot-dev proxy_ssh
  aliyun-cli email
)
# Reserved directories under ~/cicy-ai/skills/ that must never be treated as
# user skills:
#   cicy-skills  — source dir of the Go binary (and host of skill-author)
#   skill-author — meta-skill itself (lives at cicy-skills/skill-author/, but
#                  block the name to keep ~/cicy-ai/skills/skill-author/ free)
RESERVED_DIRS=(cicy-skills skill-author)

# ── Helpers ─────────────────────────────────────────────────────────────────
die() { printf >&2 'skill-author: %s\n' "$1"; exit "${2:-1}"; }

is_builtin() {
  local n="$1"
  for b in "${BUILTIN_SKILLS[@]}"; do
    [[ "$n" == "$b" ]] && return 0
  done
  return 1
}

is_reserved() {
  local n="$1"
  for r in "${RESERVED_DIRS[@]}"; do
    [[ "$n" == "$r" ]] && return 0
  done
  return 1
}

validate_name() {
  local n="$1"
  [[ -n "$n" ]] || die "name required" 1
  [[ "$n" =~ ^[a-z][a-z0-9-]*$ ]] || die "name must be lowercase kebab-case starting with a letter: $n" 1
  is_reserved "$n" && die "name '$n' is reserved" 3
  is_builtin "$n" && die "name '$n' collides with a built-in skill (use 'cicy-skills' for those)" 3
  return 0
}

list_user_skills() {
  # echo each user-skill directory name on its own line
  [[ -d "$SKILLS_ROOT" ]] || return 0
  local d name
  for d in "$SKILLS_ROOT"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    is_reserved "$name" && continue
    is_builtin "$name" && continue
    [[ -f "$d/SKILL.md" ]] || continue
    printf '%s\n' "$name"
  done
}

frontmatter_field() {
  # Extract `name:` or `description:` from a SKILL.md frontmatter block.
  # Usage: frontmatter_field <skill_md> <field>
  local f="$1" key="$2"
  awk -v k="$key" '
    BEGIN { in_fm=0; first=1; pat="^[[:space:]]*"k":[[:space:]]*" }
    /^---[[:space:]]*$/ {
      if (first) { in_fm=1; first=0; next }
      if (in_fm) { exit }
    }
    in_fm {
      if (match($0, pat)) {
        v = substr($0, RSTART+RLENGTH)
        sub(/[[:space:]]+$/, "", v)
        print v
        exit
      }
    }
  ' "$f"
}

# ── Commands ────────────────────────────────────────────────────────────────

cmd_new() {
  local name="" description=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --description) description="${2:-}"; shift 2 ;;
      --description=*) description="${1#--description=}"; shift ;;
      -h|--help) printf 'Usage: skill-author new <name> [--description "..."]\n'; return 0 ;;
      -*) die "unknown flag: $1" 1 ;;
      *)
        if [[ -z "$name" ]]; then name="$1"; shift; else die "unexpected arg: $1" 1; fi
        ;;
    esac
  done
  validate_name "$name"
  local target="$SKILLS_ROOT/$name"
  [[ -e "$target" ]] && die "$target already exists" 1
  [[ -d "$TEMPLATES_DIR" ]] || die "templates dir missing: $TEMPLATES_DIR" 2

  mkdir -p "$target/references"
  local title
  title="$(printf '%s' "$name" | awk -F- '{ for(i=1;i<=NF;i++){ $i=toupper(substr($i,1,1)) tolower(substr($i,2)) } print }' OFS=' ')"
  local desc="${description:-One-line imperative description; replace me before installing.}"

  # render templates
  local src dst
  for src in "$TEMPLATES_DIR/SKILL.md" "$TEMPLATES_DIR/references/help.md" "$TEMPLATES_DIR/references/tools.md"; do
    dst="$target/${src#$TEMPLATES_DIR/}"
    mkdir -p "$(dirname "$dst")"
    sed -e "s|__NAME__|$name|g" \
        -e "s|__TITLE__|$title|g" \
        -e "s|__DESCRIPTION__|$desc|g" \
        "$src" > "$dst"
  done

  printf 'created %s\n' "$target"
  printf 'next steps:\n'
  printf '  1. edit %s/SKILL.md\n' "$target"
  printf '  2. skill-author install %s\n' "$name"
}

cmd_install() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "usage: skill-author install <name>|all" 1

  local names=()
  if [[ "$target" == "all" ]]; then
    while IFS= read -r n; do names+=("$n"); done < <(list_user_skills)
    [[ ${#names[@]} -gt 0 ]] || { printf 'no user skills found under %s\n' "$SKILLS_ROOT"; return 0; }
  else
    validate_name "$target"
    names=("$target")
  fi

  local n src profile dst
  for n in "${names[@]}"; do
    src="$SKILLS_ROOT/$n"
    [[ -d "$src" ]] || die "source not found: $src" 2
    [[ -f "$src/SKILL.md" ]] || die "missing SKILL.md in $src" 2
    for profile in "${PROFILES[@]}"; do
      dst="$HOME/$profile/skills/$n"
      mkdir -p "$(dirname "$dst")"
      rm -rf "$dst"
      cp -a "$src" "$dst"
    done
    printf 'installed %s → .claude .codex .opencode\n' "$n"
  done
}

cmd_list() {
  local show_builtin=0 only_installed=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --builtin) show_builtin=1; shift ;;
      --installed) only_installed=1; shift ;;
      -h|--help) printf 'Usage: skill-author list [--builtin] [--installed]\n'; return 0 ;;
      *) die "unknown flag: $1" 1 ;;
    esac
  done

  printf '%-22s %-14s %s\n' NAME STATUS DESCRIPTION
  local n src desc status missing
  while IFS= read -r n; do
    src="$SKILLS_ROOT/$n"
    desc="$(frontmatter_field "$src/SKILL.md" description)"
    missing=0
    for p in "${PROFILES[@]}"; do
      [[ -f "$HOME/$p/skills/$n/SKILL.md" ]] || missing=1
    done
    if [[ $missing -eq 1 ]]; then
      status=source-only
    else
      status=installed
    fi
    if [[ $only_installed -eq 1 && "$status" != "installed" ]]; then continue; fi
    printf '%-22s %-14s %s\n' "$n" "$status" "${desc:-(no description)}"
  done < <(list_user_skills)

  if [[ $show_builtin -eq 1 ]]; then
    printf '\n# built-in (managed by cicy-skills, not editable here):\n'
    for b in "${BUILTIN_SKILLS[@]}"; do printf '  %s\n' "$b"; done
  fi
}

cmd_remove() {
  local name="" assume_yes=0 emit_json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) assume_yes=1; shift ;;
      --json) emit_json=1; assume_yes=1; shift ;;  # --json implies --yes (agent-friendly)
      -h|--help) printf 'Usage: skill-author remove <name> [--yes] [--json]\n'; return 0 ;;
      -*) die "unknown flag: $1" 1 ;;
      *) name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: skill-author remove <name>" 1
  is_builtin "$name" && die "refusing to remove built-in skill: $name" 3
  is_reserved "$name" && die "refusing to remove reserved dir: $name" 3

  # Refuse to silently "remove" something that doesn't exist anywhere — an
  # agent calling this on a typo should get a clear not-found signal.
  local src="$SKILLS_ROOT/$name"
  local exists=0
  [[ -d "$src" ]] && exists=1
  local p
  for p in "${PROFILES[@]}"; do
    [[ -d "$HOME/$p/skills/$name" ]] && exists=1
  done
  if [[ $exists -eq 0 ]]; then
    if [[ $emit_json -eq 1 ]]; then
      printf '{"ok":false,"name":"%s","error":"not found"}\n' "$name"
    fi
    die "skill not found anywhere: $name" 2
  fi

  if [[ $assume_yes -ne 1 ]]; then
    printf 'remove %s and all 3 profile copies? [y/N] ' "$name"
    read -r reply
    [[ "$reply" =~ ^[yY]$ ]] || { printf 'aborted\n'; return 1; }
  fi

  local removed_paths=()
  if [[ -d "$src" ]]; then
    rm -rf "$src" && removed_paths+=("$src")
  fi
  local target
  for p in "${PROFILES[@]}"; do
    target="$HOME/$p/skills/$name"
    if [[ -d "$target" ]]; then
      rm -rf "$target" && removed_paths+=("$target")
    fi
  done

  if [[ $emit_json -eq 1 ]]; then
    # Emit a single-line JSON object so agents can parse the result.
    local joined=""
    for ((i=0; i<${#removed_paths[@]}; i++)); do
      [[ $i -gt 0 ]] && joined+=","
      joined+="\"${removed_paths[i]}\""
    done
    printf '{"ok":true,"name":"%s","removed":[%s]}\n' "$name" "$joined"
  else
    printf 'removed %s\n' "$name"
  fi
}

cmd_show() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: skill-author show <name>" 1
  local f="$SKILLS_ROOT/$name/SKILL.md"
  [[ -f "$f" ]] || die "not found: $f" 2
  cat "$f"
}

cmd_validate() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: skill-author validate <name>" 1
  local src="$SKILLS_ROOT/$name"
  local skill_md="$src/SKILL.md"
  local errors=()

  [[ -f "$skill_md" ]] || errors+=("missing $skill_md")
  if [[ -f "$skill_md" ]]; then
    local fm_name fm_desc
    fm_name="$(frontmatter_field "$skill_md" name)"
    fm_desc="$(frontmatter_field "$skill_md" description)"
    [[ -n "$fm_name" ]] || errors+=("frontmatter missing 'name:'")
    [[ -n "$fm_desc" ]] || errors+=("frontmatter missing 'description:'")
    [[ "$fm_name" == "$name" ]] || errors+=("frontmatter name '$fm_name' != directory name '$name'")
  fi
  [[ -s "$src/references/help.md" ]] || errors+=("missing or empty references/help.md")
  [[ -s "$src/references/tools.md" ]] || errors+=("missing or empty references/tools.md")

  if [[ ${#errors[@]} -gt 0 ]]; then
    printf '%s: invalid\n' "$name" >&2
    for e in "${errors[@]}"; do printf '  - %s\n' "$e" >&2; done
    return 4
  fi
  printf '%s: ok\n' "$name"
}

usage() {
  cat <<EOF
skill-author — manage user-authored skills under ~/cicy-ai/skills/

Commands:
  new <name> [--description "..."]   scaffold a new skill from templates
  install <name>|all                 sync source → ~/.claude ~/.codex ~/.opencode
  list [--builtin] [--installed]     list user skills (and optionally built-ins)
  remove <name> [--yes]              delete source + all 3 profile copies
  show <name>                        cat the SKILL.md
  validate <name>                    lint frontmatter + file layout

See ~/cicy-ai/skills/cicy-skills/skill-author/references/help.md for the full guide.
EOF
}

main() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || { usage; exit 1; }
  shift
  case "$sub" in
    new)      cmd_new "$@" ;;
    install)  cmd_install "$@" ;;
    list|ls)  cmd_list "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    show|cat) cmd_show "$@" ;;
    validate|lint) cmd_validate "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown subcommand: $sub (try 'skill-author help')" 1 ;;
  esac
}

main "$@"
