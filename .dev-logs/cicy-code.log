    return 1
  fi
}
install_skill_action() {
  read -r -p '请输入 skill slug: ' skill_slug || true
  skill_slug="$(printf '%s' "$skill_slug" | xargs)"
  if [ -z "$skill_slug" ]; then
    cicy_log "未输入 skill slug，已取消。"
    return 0
  fi
  cicy_log "正在安装 skill: $skill_slug"
