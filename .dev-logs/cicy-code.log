#!/usr/bin/env bash

if [ -z "${BASH_VERSION:-}" ]; then
  _cicy_boot_script_path="$PWD/.cicy/boot.sh"
  bash "$_cicy_boot_script_path"
  _cicy_boot_status=$?
  unset _cicy_boot_script_path
  return "$_cicy_boot_status" 2>/dev/null || exit "$_cicy_boot_status"
fi

_cicy_boot_script="${BASH_SOURCE:-$0}"
_cicy_runtime_dir="$(cd "$(dirname "$_cicy_boot_script")" && pwd)"
export CICY_RUNTIME_DIR="$_cicy_runtime_dir"
_cicy_workspace_dir="$(cd "$_cicy_runtime_dir/.." && pwd)"
cd "$_cicy_workspace_dir"

touch ~/.cicy_tmux.conf
source ~/.cicy_tmux.conf
export X_AGENT_ID='w-10003:main.0'
export X_AGENT_SHORT_ID='w-10003'
export CICY_AGENT_TYPE='opencode'
export WORKSPACE='/home/cicy/cicy-ai/workers/w-10003'
clear
__cicy_require_command 'opencode' 'OpenCode' 'mkdir -p "$HOME/.npm-global/bin" "$HOME/.npm-global/lib" "$HOME/.npm-global/lib/node_modules" && npm install -g --prefix "$HOME/.npm-global" opencode-ai@latest' "$HOME/.cicy/opencode-install-w-10003.log"
export CICY_OPENAI_BASE_URL='http://127.0.0.1:8008/api/ai-gateway/openai/w-10003'
export OPENCODE_CONFIG="$WORKSPACE/.opencode/opencode.json"
export OPENCODE_CONFIG_ROOT="$WORKSPACE/.opencode/xdg"
export CICY_OPENCODE_MARKER="$WORKSPACE/.opencode/running"
rm -f "$CICY_OPENCODE_MARKER"
mkdir -p "$WORKSPACE/.opencode" "$OPENCODE_CONFIG_ROOT"
cat > "$WORKSPACE/.opencode/reply-in-chinese.md" <<'EOF'
Always reply in Chinese unless the user explicitly asks for another language.
Keep code, commands, file paths, environment variables, API identifiers, and other literal tokens unchanged when accuracy matters.
EOF
cat > "$OPENCODE_CONFIG" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "instructions": ["${WORKSPACE}/.opencode/reply-in-chinese.md"],
  "provider": {
    "cicyai": {
      "npm": "@ai-sdk/openai-compatible",
      "api": "openai",
      "name": "cicyAi Gateway",
      "options": {
        "baseURL": "${CICY_OPENAI_BASE_URL}"
      }
    }
  }
}
EOF
cicy_run_opencode() {
  XDG_CONFIG_HOME="$OPENCODE_CONFIG_ROOT" OPENCODE_CONFIG="$OPENCODE_CONFIG" opencode
}
cicy_start_opencode() {
  if [ -f "$CICY_OPENCODE_MARKER" ]; then
    echo '[cicy] OpenCode is already starting or running.'
    return 0
  fi
  : > "$CICY_OPENCODE_MARKER"
  cicy_run_opencode
  status=$?
  rm -f "$CICY_OPENCODE_MARKER"
  echo '[cicy] OpenCode exited. Run cicy_start_opencode to relaunch.'
  return "$status"
}
cicy_run_opencode
unset _cicy_boot_script _cicy_runtime_dir _cicy_workspace_dir
