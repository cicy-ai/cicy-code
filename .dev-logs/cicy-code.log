    restart_gateway_action || true
    cicy_log "验证方式：在飞书里发送 /feishu start"
    cicy_log "如需授权更多飞书能力，可发送 /feishu auth"
    cicy_log "如需开启流式输出，可运行：openclaw --profile w-10009 config set channels.feishu.streaming true"
  else
