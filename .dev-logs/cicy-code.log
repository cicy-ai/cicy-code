  printf '2. 查看 OpenClaw 状态\n'
  printf '3. 重启 Gateway\n'
  printf '4. 查看 Dashboard 地址\n'
  printf '5. 安装插件\n'
  printf '6. 安装 Skill\n'
  printf '7. 安装飞书\n'
  printf '8. 添加 Channel\n'
  printf '9. 查看最近日志\n'
  printf '10. 向当前微信发送测试消息\n'
  printf '0. 刷新管理台\n'
}
