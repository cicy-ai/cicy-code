    if grep -Fq "weixin monitor started" "$gateway_log" 2>/dev/null && grep -Fq "account=${account_id}" "$gateway_log" 2>/dev/null; then
      cicy_log "微信监控已上线。"
      return 0
    fi
    if [ $((i % 5)) -eq 0 ]; then
      cicy_log "等待微信可交互 ${i}s/120s ..."
    fi
